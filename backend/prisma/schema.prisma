generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  usn       String?
  branch    String?
  semester  Int?
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  learningStates LearningState[]
  studySessions  StudySession[]
  testResults    TestResult[]
  cheatFlags     CheatFlag[]
  notifications  Notification[]
  journalEntries JournalEntry[]
  studyPlans     StudyPlan[]
  achievements   Achievement[]
  submissions    AssignmentSubmission[]
  notesUploaded  Notes[]       @relation("NotesUploadedBy")
  assignmentsCreated Assignment[] @relation("AssignmentsCreatedBy")
  classesCreated Class[]       @relation("ClassesCreatedBy")
  testsCreated   Test[]        @relation("TestsCreatedBy")
  chatSessions   ChatSession[]
  studyTasks     StudyTask[]
  planTasks      PlanTask[]    @relation("UserPlanTasks")
  subTopicProgress SubTopicProgress[]
  activityLogs   ActivityLog[]
  studentTargets StudentTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id                 String  @id @default(cuid())
  name               String
  branch             String
  semester           Int
  createdByTeacherId String
  teacher            User    @relation("ClassesCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  students           User[]
  notes              Notes[]
  assignments        Assignment[]
  tests              Test[]

  createdAt DateTime @default(now())
}

model Subject {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  semester       Int
  credits        Int             @default(4)
  modules        Module[]
  courseOutcomes CourseOutcome[]

  createdAt DateTime @default(now())
}

model Module {
  id           String  @id @default(cuid())
  subjectId    String
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleNumber Int
  name         String

  @@unique([subjectId, moduleNumber])
}

model CourseOutcome {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  coNumber    Int
  description String
  bloomsLevel String
  modules     String
  weightage   String

  @@unique([subjectId, coNumber])
}

model Topic {
  id            String  @id @default(cuid())
  subjectCode   String
  moduleNumber  Int
  name          String
  description   String  @default("")
  order         Int     @default(0)
  pyqImportance Float   @default(0)
  prerequisites Topic[] @relation("TopicDependencies")
  dependents    Topic[] @relation("TopicDependencies")

  learningStates LearningState[]
  studySessions  StudySession[]
  subTopics      SubTopic[]

  createdAt DateTime @default(now())

  @@index([subjectCode])
}

model SubTopic {
  id         String   @id @default(cuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  createdAt  DateTime @default(now())

  progress SubTopicProgress[]

  @@index([topicId])
}

model SubTopicProgress {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subTopicId  String
  subTopic    SubTopic  @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([studentId, subTopicId])
}

model LearningState {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mastery        Float     @default(0.2)
  stability      Float     @default(0.5)
  difficulty     Float     @default(0.5)
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  timesReviewed  Int       @default(0)
  lastReviewedAt DateTime?
  retention          Float     @default(1.0)
  forgettingRisk     Float     @default(0.0)
  confidence         Float     @default(0.5)
  learningVelocity   Float     @default(0.0)
  timeSpentSec       Int       @default(0)
  avgResponseTimeSec Float     @default(0.0)
  priority           Float     @default(0.5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId])
}

model StudySession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  durationMin     Int       @default(0)
  method          String    @default("study")
  correct         Boolean?
  responseTimeSec Float?
  confidence      Float?
  subjectCode     String?
  moduleNumber    Int?
  createdAt       DateTime  @default(now())
}

model Document {
  id                  String          @id @default(cuid())
  title               String
  subjectCode         String
  moduleNumber        Int?
  fileUrl             String
  docType             String          @default("notes")
  uploadedByTeacherId String?
  chunks              DocumentChunk[]
  pageImages          PageImage[]

  createdAt DateTime @default(now())
}

model DocumentChunk {
  id               String   @id @default(cuid())
  sourceDocumentId String
  sourceDocument   Document @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  subjectCode      String
  moduleNumber     Int?
  pageNumber       Int?
  content          String
  embedding        Unsupported("vector(384)")
  createdAt        DateTime @default(now())

  @@index([subjectCode])
}

model PageImage {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  fileUrl    String
  createdAt  DateTime @default(now())

  @@unique([documentId, pageNumber])
}

model Notes {
  id                  String   @id @default(cuid())
  subjectCode         String
  moduleNumber        Int?
  topicId             String?
  topicName           String?
  title               String
  description         String   @default("")
  fileUrl             String
  fileSize            Int      @default(0)
  isPublished         Boolean  @default(true)
  uploadedByTeacherId String
  uploadedBy          User     @relation("NotesUploadedBy", fields: [uploadedByTeacherId], references: [id], onDelete: Cascade)
  classId             String?
  class               Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Assignment {
  id                  String                 @id @default(cuid())
  subjectCode         String
  title               String
  description         String                 @default("")
  dueDate             DateTime?
  createdByTeacherId  String
  createdBy           User                   @relation("AssignmentsCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  classId             String?
  class               Class?                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions         AssignmentSubmission[]

  createdAt DateTime @default(now())
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String?
  fileUrls     Json?
  submittedAt  DateTime   @default(now())
  marks        Float?
  feedback     String?
  gradedAt     DateTime?

  @@unique([assignmentId, studentId])
}

model Test {
  id                  String       @id @default(cuid())
  subjectCode         String
  title               String
  durationMin         Int          @default(30)
  isActive            Boolean      @default(false)
  moduleNumber        Int?
  topicIds            Json?
  difficulty          String       @default("MEDIUM")
  attemptLimit        Int          @default(3)
  startTime           DateTime?
  endTime             DateTime?
  totalMarks          Float        @default(20)
  integrityThreshold  Int          @default(4)
  createdByTeacherId  String
  teacher             User         @relation("TestsCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  classId             String?
  class               Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  questions           Question[]
  results             TestResult[]
  cheatFlags          CheatFlag[]

  createdAt DateTime @default(now())
}

model Question {
  id           String   @id @default(cuid())
  testId       String
  test         Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  text         String
  options          Json
  correctIndex     Int          @default(0)
  marks            Int          @default(2)
  topicId          String?
  questionType     String       @default("MCQ")
  rubric           Json?
  expectedKeywords Json?
  modelAnswer      String?

  createdAt DateTime @default(now())
}

model TestResult {
  id                   String   @id @default(cuid())
  testId               String
  test                 Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId            String
  student              User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber        Int      @default(1)
  score                Float
  totalMarks           Float
  answers              Json?
  status               String   @default("SUBMITTED")
  startedAt            DateTime @default(now())
  submittedAt          DateTime @default(now())
  timeTakenSec         Int      @default(0)
  integrityWarnings    Int      @default(0)
  evaluationDetails    Json?
  teacherFeedback      String?
  teacherMarksOverride Float?

  @@unique([testId, studentId, attemptNumber])
}

model CheatFlag {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type          String
  severity      String   @default("LOW")
  details       String   @default("")
  attemptNumber Int      @default(1)
  eventCount    Int      @default(1)
  actionTaken   String   @default("WARNING")
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  mood      String?
  createdAt DateTime @default(now())
}

model StudyPlan {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects         Json       @default("[]")
  examDate         DateTime?
  targetFinishDate DateTime?
  hoursPerDay      Float      @default(2.0)
  mode             String     @default("3-2-1")
  status           String     @default("ACTIVE")
  date             String?
  plan             Json?
  tasks            PlanTask[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt

  @@index([userId])
}

model PlanTask {
  id                String    @id @default(cuid())
  planId            String
  plan              StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation("UserPlanTasks", fields: [userId], references: [id], onDelete: Cascade)
  subjectCode       String
  moduleNumber      Int?
  topicId           String?
  topicName         String
  subTopicId        String?
  subTopicName      String?
  scheduledDate     String
  scheduledSlot     String?
  minutes           Int       @default(30)
  type              String    @default("learn")
  status            String    @default("PENDING")
  completedAt       DateTime?
  order             Int       @default(0)
  todoText          String?
  subPoints         Json?
  selfCheckQuestion String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([userId, scheduledDate])
  @@index([planId])
}

model Achievement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     String
  name     String
  earnedAt DateTime @default(now())
}

model ChatSession {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  subjectCode  String?
  moduleNumber Int?
  messages     ChatMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  chunks    Json?
  diagrams  Json?
  quiz      Json?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model StudyTask {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectCode  String
  subjectName  String   @default("")
  moduleNumber Int?
  topicId      String?
  topicName    String
  minutes      Int
  date             String
  done             Boolean   @default(false)
  order            Int       @default(0)
  taskType         String    @default("learn")
  difficulty       String    @default("medium")
  priority         String    @default("medium")
  reason           String    @default("")
  planType         String    @default("3-2-1")
  status           String    @default("pending")
  feedback         String?
  estimatedMinutes Int       @default(20)
  masteryBefore    Float?
  masteryAfter     Float?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String
  subjectCode String?
  topicId     String?
  durationSec Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, eventType])
}

model StudentTarget {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectCode        String
  examDate           DateTime?
  targetMastery      Float    @default(0.85)
  dailyStudyHours    Float    @default(2.0)
  preferredStudyTime String   @default("EVENING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, subjectCode])
}
