// AdaptLearn — Prisma schema
// Local Postgres 18 + pgvector (extension "vector", created manually)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  password       String
  name           String
  role           Role                 @default(STUDENT)
  usn            String?
  branch         String?
  semester       Int?
  classId        String?
  class          Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)

  learningStates LearningState[]
  studySessions  StudySession[]
  testResults    TestResult[]
  cheatFlags     CheatFlag[]
  notifications  Notification[]
  journalEntries JournalEntry[]
  studyPlans     StudyPlan[]
  achievements   Achievement[]
  submissions    AssignmentSubmission[]
  notesUploaded  Notes[]              @relation("NotesUploadedBy")
  assignmentsCreated Assignment[]     @relation("AssignmentsCreatedBy")
  classesCreated Class[]              @relation("ClassesCreatedBy")
  testsCreated   Test[]               @relation("TestsCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id                 String     @id @default(cuid())
  name               String
  branch             String
  semester           Int
  createdByTeacherId String
  teacher            User       @relation("ClassesCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  students           User[]
  notes              Notes[]
  assignments        Assignment[]
  tests              Test[]

  createdAt DateTime @default(now())
}

model Subject {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  semester        Int
  credits         Int             @default(4)
  modules         Module[]
  courseOutcomes  CourseOutcome[]

  createdAt DateTime @default(now())
}

model Module {
  id           String  @id @default(cuid())
  subjectId    String
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleNumber Int
  name         String

  @@unique([subjectId, moduleNumber])
}

model CourseOutcome {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  coNumber    Int
  description String
  bloomsLevel String
  modules     String
  weightage   String

  @@unique([subjectId, coNumber])
}

model Topic {
  id             String         @id @default(cuid())
  subjectCode    String
  moduleNumber   Int
  name           String
  description    String         @default("")
  order          Int            @default(0)
  pyqImportance  Float          @default(0) // 0-100, PYQ frequency score
  prerequisites  Topic[]        @relation("TopicDependencies")
  dependents     Topic[]        @relation("TopicDependencies")

  learningStates LearningState[]
  studySessions  StudySession[]

  createdAt DateTime @default(now())

  @@index([subjectCode])
}

model LearningState {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mastery        Float    @default(0.2) // BKT p-known
  stability      Float    @default(0.5)
  difficulty     Float    @default(0.5)
  correctCount   Int      @default(0)
  wrongCount     Int      @default(0)
  timesReviewed  Int      @default(0)
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId])
}

model StudySession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  durationMin Int      @default(0)
  method      String   @default("study")
  correct     Boolean?
  createdAt   DateTime @default(now())
}

model Document {
  id                String          @id @default(cuid())
  title             String
  subjectCode       String
  moduleNumber      Int?
  fileUrl           String
  docType           String          @default("notes") // syllabus | notes | pyq | model-paper | co
  uploadedByTeacherId String?
  chunks            DocumentChunk[]
  pageImages        PageImage[]

  createdAt DateTime @default(now())
}

model DocumentChunk {
  id               String   @id @default(cuid())
  sourceDocumentId String
  sourceDocument   Document @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  subjectCode      String
  moduleNumber     Int?
  pageNumber       Int? // PDF page (1-based) this chunk was extracted from
  content          String
  embedding        Unsupported("vector(384)")
  createdAt        DateTime @default(now())

  @@index([subjectCode])
}

// One rendered PNG per PDF page — the "diagram" retrieval surface.
model PageImage {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber  Int // 1-based PDF page
  fileUrl     String
  createdAt   DateTime @default(now())

  @@unique([documentId, pageNumber])
}

model Notes {
  id                 String   @id @default(cuid())
  subjectCode        String
  moduleNumber       Int?
  title              String
  fileUrl            String
  uploadedByTeacherId String
  uploadedBy         User     @relation("NotesUploadedBy", fields: [uploadedByTeacherId], references: [id], onDelete: Cascade)
  classId            String?
  class              Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Assignment {
  id                 String                 @id @default(cuid())
  subjectCode        String
  title              String
  description        String                 @default("")
  dueDate            DateTime?
  createdByTeacherId String
  createdBy          User                   @relation("AssignmentsCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  classId            String?
  class              Class?                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions        AssignmentSubmission[]

  createdAt DateTime @default(now())
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String
  submittedAt  DateTime   @default(now())
  marks        Float?
  feedback     String?
  gradedAt     DateTime?

  @@unique([assignmentId, studentId])
}

model Test {
  id                 String      @id @default(cuid())
  subjectCode        String
  title              String
  durationMin        Int         @default(30)
  isActive           Boolean     @default(false)
  createdByTeacherId String
  teacher            User        @relation("TestsCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  classId            String?
  class              Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  questions          Question[]
  results            TestResult[]
  cheatFlags         CheatFlag[]

  createdAt DateTime @default(now())
}

model Question {
  id            String   @id @default(cuid())
  testId        String
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  text          String
  options       Json
  correctIndex  Int
  marks         Int      @default(2)
  topicId       String?
  questionType  String   @default("MCQ")

  createdAt DateTime @default(now())
}

model TestResult {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Float
  totalMarks  Float
  answers     Json?
  submittedAt DateTime @default(now())

  @@unique([testId, studentId])
}

model CheatFlag {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String // TAB_SWITCH | COPY_PASTE | SPEED_ANOMALY | EXTERNAL
  severity  String   @default("LOW") // LOW | MEDIUM | HIGH
  details   String   @default("")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  mood      String?
  createdAt DateTime @default(now())
}

model StudyPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  plan      Json
  createdAt DateTime @default(now())
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  name      String
  earnedAt  DateTime @default(now())
}
